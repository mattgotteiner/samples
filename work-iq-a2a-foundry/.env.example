# Copy to .env and fill in, or let `azd up` populate these for you.
#
# After `azd up`, these values are written to the azd environment. To load them
# into your shell instead of using a .env file, run:
#
#     azd env get-values > .env
#
# Never commit a filled-in .env file.

# Foundry project endpoint, from `azd env get-value AZURE_AI_PROJECT_ENDPOINT`.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# Name of the RemoteA2A connection that points at Work IQ.
WORK_IQ_CONNECTION_NAME=work-iq-a2a

# Name of a model deployment in the Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# --- Optional -------------------------------------------------------------

# Force a specific tenant during local sign-in. Useful when you are signed in
# to more than one tenant.
# AZURE_TENANT_ID=

# Question to ask when none is passed on the command line.
# WORK_IQ_PROMPT=What did I work on this week?

# Name for the temporary agent this sample creates.
# WORK_IQ_AGENT_NAME=work-iq-coordinator

# Keep the temporary agent version instead of deleting it after the run.
# WORK_IQ_KEEP_AGENT_VERSION=false

# Append the raw response stream to this file as JSON Lines, for debugging.
# WORK_IQ_EVENT_LOG_PATH=out/events.jsonl

# Maximum seconds to wait for a single response.
# WORK_IQ_TIMEOUT_SECONDS=300
